{
  "name": "runework-cli",
  "root": "packages/cli",
  "sourceRoot": "packages/cli/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node scripts/build-package.mjs packages/cli/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/cli/src/",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --conditions=source --test packages/cli/src/**/*.test.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
