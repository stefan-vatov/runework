{
  "name": "@hammerkit/core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "source": "./src/adapters/index.ts",
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./zx": {
      "source": "./src/zx.ts",
      "types": "./dist/zx.d.ts",
      "default": "./dist/zx.js"
    },
    "./ink": {
      "source": "./src/ink.ts",
      "types": "./dist/ink.d.ts",
      "default": "./dist/ink.js"
    }
  },
  "files": ["dist", "src"],
  "dependencies": {
    "@types/react": "^19.2.14",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.4",
    "zx": "^8.0.0"
