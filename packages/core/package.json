{
  "name": "@runework/core",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "source": "./src/adapters/index.ts",
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./zx": {
      "source": "./src/zx.ts",
      "types": "./dist/zx.d.ts",
      "default": "./dist/zx.js"
    }
  },
  "files": [
    "dist",
    "src/adapters",
    "src/core",
    "src/index.ts",
    "src/models.ts",
    "src/zx.ts"
