{
  "name": "runework-reporters",
  "root": "packages/reporters",
  "sourceRoot": "packages/reporters/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node scripts/build-package.mjs packages/reporters/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/reporters/src/",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --conditions=source --test packages/reporters/src/*.unit.test.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
