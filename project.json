{
  "name": "hammerkit",
  "root": ".",
  "sourceRoot": "src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node scripts/build-package.mjs tsconfig.build.json --chmod dist/cli"
      },
      "dependsOn": ["^build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint src/ scripts/"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --conditions=source --test src/hammerkit.test.ts src/hammerkit.smoke.test.ts"
      }
    }
  }
}
