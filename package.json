{
  "name": "runework",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "zx-powered automation toolkit for CLI coding agents (codex, claude, opencode)",
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "runework-run": "./dist/cli/run.js",
    "runework-compare": "./dist/cli/compare.js",
    "runework-detect": "./dist/cli/detect.js",
    "runework-init": "./dist/cli/init.js",
    "runework-pipeline": "./dist/cli/pipeline.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "source": "./src/adapters/index.ts",
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./workflows": {
      "source": "./src/workflows/index.ts",
      "types": "./dist/workflows/index.d.ts",
      "default": "./dist/workflows/index.js"
    },
    "./pipelines": {
      "source": "./src/pipelines/index.ts",
      "types": "./dist/pipelines/index.d.ts",
      "default": "./dist/pipelines/index.js"
    },
    "./zx": {
      "source": "./src/zx.ts",
      "types": "./dist/zx.d.ts",
      "default": "./dist/zx.js"
    },
    "./ink": {
      "source": "./src/ink.ts",
      "types": "./dist/ink.d.ts",
      "default": "./dist/ink.js"
    }
  },
  "files": [
    "dist",
    "src/adapters",
    "src/cli",
    "src/core",
    "src/pipelines",
    "src/workflows",
    "src/index.ts",
    "src/ink.ts",
    "src/models.ts",
    "src/zx.ts",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/prepare.mjs",
    "test": "npx nx run-many -t test --all",
    "test:source": "node --conditions=source --test src/runework.test.ts",
    "test:smoke": "node --conditions=source --test src/runework.smoke.test.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:all": "npx nx run-many -t lint --all",
    "build:all": "npx nx run-many -t build --all",
    "run": "node --conditions=source src/cli/run.ts",
    "compare": "node --conditions=source src/cli/compare.ts",
    "detect": "node --conditions=source src/cli/detect.ts",
    "pipeline": "node --conditions=source src/cli/pipeline.ts"
  },
  "dependencies": {
    "@runework/core": "file:packages/core",
    "@runework/workflows": "file:packages/workflows",
    "@runework/pipelines": "file:packages/pipelines",
    "@runework/cli": "file:packages/cli",
    "@types/react": "^19.2.14",
    "ink": "^6.8.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.4",
    "zx": "^8.0.0"
  },
  "bundleDependencies": [
    "@runework/core",
    "@runework/workflows",
    "@runework/pipelines",
    "@runework/cli"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "nx": "^21.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
