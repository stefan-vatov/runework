{
  "name": "runework-workspace",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "workspace root for the runework monorepo",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/prepare.mjs",
    "release": "npx nx release --skip-publish",
    "release:dry-run": "npx nx release --dry-run --skip-publish",
    "release:major": "npx nx release major --skip-publish",
    "release:minor": "npx nx release minor --skip-publish",
    "release:patch": "npx nx release patch --skip-publish",
    "release:publish": "npx nx release publish",
    "test": "npm run test:unit && npm run test:integration && npm run test:publish",
    "test:unit": "node --conditions=source --test \"packages/*/src/*.unit.test.ts\"",
    "test:integration": "node --conditions=source --test \"packages/*/src/*.integration.test.ts\"",
    "test:publish": "node --conditions=source --test \"packages/*/src/*.publish.test.ts\"",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:all": "npm run lint",
    "build:all": "node scripts/build.mjs",
    "run": "node --conditions=source packages/runework/src/cli/run.ts",
    "detect": "node --conditions=source packages/runework/src/cli/detect.ts",
    "pipeline": "node --conditions=source .runework/scripts/pipeline.ts"
  },
  "devDependencies": {
    "@nx/js": "^21.0.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.21",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "nx": "^21.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
